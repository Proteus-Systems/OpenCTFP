# CORE
# the url that allows the website to connect to the database. using a hosted provider, paste the direct, non-pooled link here and comment out the #LOCAL DATABASE section
#DATABASE_URL= 
# the full address of the platform. Used to build joining links, qr codes and authentication. use http://localhost:3000 for local development
BASE_URL=http://openctfp.ctf
# the domain of the platform, used for generating instance subdomains. use localhost for local development
BASE_DOMAIN=openctfp.ctf

#LOCAL DATABASE (local docker-compose only)
# the username used to login to the postgres db instance
POSTGRES_USER=username
# the password used to login in the postgres db instance. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=32bytehexpassword
# the name of the postgres db
POSTGRES_DB=dbname
# the url that allows the website to connect to the database
DATABASE_URL=postgresql://<username>:<32bytehexpassword>@localhost:5432/<dbname>?schema=public

# ROUTING
# determines how instance links are formatted. can be subdomain or port. subdomain assigns each instance a subdomain: x.BASE_DOMAIN, port assigns each instance a port: BASE_DOMAIN:x subdomain is default
ROUTING_MODE=subdomain
# determines the range of ports the platform is allowed to hand out to instances, only required if ROUTING_MODE is port. e.g. 20000-21000
# PORT_RANGE=20000-21000

# SECRETS (DO NOT SHARE)
# Generate each with: openssl rand -hex 32
# used by authentication to sign and encrypt login sessions, if this leaks someone can forge sessions and login as anyone
AUTH_SECRET=32bytehexstring
# a token used to sign the links that allow players to access their instances
INSTANCE_TOKEN_SECRET=32bytehexstring

# RESOURCE CAPS
# the most player instances that can run at once across the whole platform, so the host doesn't run out of memory. default: 80
#MAX_INSTANCES=80
# how many instances start in parallel when everyone clicks Launch together. default: 5
#LAUNCH_CONCURRENCY=5
# the CPU limit per container (0.5 = half a core). default: 0.5
#INSTANCE_MAX_CPU=0.5
# the RAM limit per container in MB. default: 256
#INSTANCE_MAX_MEMORY_MB=256
# the process limit per container, so a fork bomb (a program that copies itself until the machine freezes) can't take the host down. default: 256
#INSTANCE_MAX_PIDS=256
# an instance nobody has visited for this long gets stopped, to free resources. default: 30
#INSTANCE_IDLE_MINUTES=30
# how long after an event ends before all its instances are deleted. It leaves a short window for screenshots and last looks. default: 10
#INSTANCE_GRACE_MINUTES=10